{
  "mode": "simulation",
  "timezone": "Asia/Seoul",
  "nightlyRunTime": "01:00",
  "morningReportTime": "07:00",
  "defaultCommand": "내일 아침 로컬기획 사무국 보고서를 만들어줘",
  "dailyKeywords": [
    "농촌 정책",
    "로컬 콘텐츠",
    "공모사업",
    "AI 자동화"
  ],
  "maxAgentRuns": 7,
  "allowExternalSend": false,
  "googleWorkspaceBriefing": {
    "oauthClientSecretPathEnv": "GOOGLE_OAUTH_CLIENT_SECRET_PATH (outside repository)",
    "oauthTokenPathEnv": "GOOGLE_OAUTH_TOKEN_PATH (outside repository)",
    "calendarId": "primary",
    "projectStateSpreadsheetId": "",
    "projectStateSpreadsheetTitleFallback": "26 양터 전체사업 총괄표",
    "projectAliasConfigPath": "automation/project-aliases.example.json",
    "scopes": [
      "gmail.readonly",
      "calendar.readonly",
      "drive.readonly",
      "spreadsheets.readonly"
    ],
    "outputDir": "reports/private",
    "writeBoundary": "Writes exactly one local Markdown report; Google Workspace write operations are forbidden."
  },
  "outputPolicy": {
    "drafts": "private",
    "publicReports": "reports/public-after-review",
    "sensitiveData": "private-only"
  }
}
